-- Detector compatível com a nova GUI: o painel pode ter outro nome.
local function qteLetter(qte)
    local t=qte:FindFirstChildWhichIsA("TextLabel")
    if not t then return nil end
    local s=tostring(t.Text):upper():gsub("%s+","")
    if s=="Q" or s=="E" or s=="Y" or s=="TAP" then return s end
    return nil
end
local function qteScreen()
    if not activeActivity() then return nil end
    for _,container in ipairs(pg:GetChildren()) do
        if container:IsA("ScreenGui") and container.Enabled and container.Name~="Xnata_GUI" then
            -- Official source stores cloned InputTemplate under Screen.
            local screen=container:FindFirstChild("Screen",true)
            if screen then
                for _,item in ipairs(screen:GetDescendants()) do
                    if item:IsA("ImageButton") and item.Visible and qteLetter(item) then
                        return screen
                    end
                end
            end
        end
    end
    return nil
end

on(RunService.Heartbeat,function(dt)
    if not alive or not auto then return end
    poll+=dt
    if poll<.12 then return end
    poll=0
    local evt=remote()
    if not evt then
        jMessage("ON | Remotes.Polichinelos não encontrado.")
        return
    end
    local now=os.clock()
    local current=activeActivity()
    if not current then
        sessionReady=false
        if startTries==0 then return end
        if now-lastStart>=3 then
            if startTries>=4 then
                detail.Text="Start enviado sem resposta: AtividadeFisica permanece vazia. Confirme a área e as permissões do jogo."
                stopJ("OFF | servidor recusou/não iniciou "..selectedActivity..".")
                return
            end
            startTries+=1
            lastStart=now
            startedByHub=true
            local ok=pcall(function()evt:FireServer("Start",selectedActivity)end)
            detail.Text="Iniciando "..selectedActivity.." | tentativa "..startTries.."/4"
            jMessage(ok and "ON | solicitando início ao servidor..." or "Erro ao solicitar início.")
        end
        return
    end
    if current~=selectedActivity then
        stopJ("OFF | atividade alterada pelo jogo: "..current)
        return
    end
    if not sessionReady then
        sessionReady=true
        baselineCount=serverCount()
        lastServerCount=baselineCount
        lastAttempt=now
        jMessage("ON | atividade confirmada pelo servidor.")
    end
    if player:GetAttribute("AtividadeFisicaPausada")==true then
        if now-lastResume>=3 then
            lastResume=now
            pcall(function()evt:FireServer("Resume")end)
        end
        jMessage("ON | atividade pausada; aguardando retomada.")
        return
    end
    local count=serverCount()
    if count~=lastServerCount then
        if count<lastServerCount then
            baselineCount=count
            jMessage("ON | contagem reiniciada pelo jogo.")
        else
            noProgressAttempts=0
            jMessage("ON | repetição confirmada pelo servidor!")
        end
        lastServerCount=count
        detail.Text="Última confirmação do servidor: "..tostring(count)
    end
    local newHits=math.max(0,count-baselineCount)
    if hits~=newHits then hits=newHits;updateJ()end
    if hits>=target then
        stopJ("META ATINGIDA! Automação interrompida; atividade do Roblox continua ativa.",false)
        return
    end
    if UIS:GetFocusedTextBox() then
        jMessage("ON | termine de digitar antes de continuar.")
        return
    end
    if now-lastAttempt<interval then return end
    if noProgressAttempts>=12 then
        detail.Text="Atividade iniciada, mas nenhuma repetição foi confirmada. Pode faltar validação Q/E pelo servidor."
        stopJ("OFF | atividade iniciada, porém o servidor não aceitou as repetições.")
        return
    end
    lastAttempt=now
    noProgressAttempts+=1
    local emulated=false
    local screen=qteScreen()
    local challenge
    if screen then
        for _,item in ipairs(screen:GetDescendants()) do
            if item:IsA("ImageButton") and item.Visible then
                local letter=qteLetter(item)
                if letter then challenge=item;break end
            end
        end
    end
    if challenge then
        local letter=qteLetter(challenge)
        if letter=="Q" or letter=="E" or letter=="Y" then
            local keyCode=Enum.KeyCode[letter]
            local manager
            pcall(function()manager=game:GetService("VirtualInputManager")end)
            if manager then
                emulated=pcall(function()
                    manager:SendKeyEvent(true,keyCode,false,game)
                    task.defer(function()pcall(function()manager:SendKeyEvent(false,keyCode,false,game)end)end)
                end)
            end
            if not emulated then
                local keypressFn=type(keypress)=="function" and keypress or nil
                local keyreleaseFn=type(keyrelease)=="function" and keyrelease or nil
                local vk=(letter=="Q" and 0x51 or letter=="E" and 0x45 or 0x59)
                if keypressFn and keyreleaseFn then
                    emulated=pcall(function()keypressFn(vk);task.delay(.06,function()pcall(keyreleaseFn,vk)end)end)
                end
            end
        elseif letter=="TAP" then
            local manager
            pcall(function()manager=game:GetService("VirtualInputManager")end)
            if manager then
                local pos=challenge.AbsolutePosition+challenge.AbsoluteSize*.5
                emulated=pcall(function()
                    manager:SendMouseButtonEvent(pos.X,pos.Y,0,true,game,0)
                    manager:SendMouseButtonEvent(pos.X,pos.Y,0,false,game,0)
                end)
            end
        end
    end
    local ok,err=true,nil
    if not emulated then ok,err=pcall(function()evt:FireServer("Add")end) end
    detail.Text=(emulated and "Entrada QTE simulada" or "Solicitação Add enviada").." | tentativa "..noProgressAttempts.." | servidor: "..tostring(count)
    if not ok then
        jMessage("Falha ao enviar repetição: "..tostring(err))
    elseif noProgressAttempts>3 then
        jMessage("ON | aguardando confirmação; o servidor pode exigir QTE.")
    end
end)
