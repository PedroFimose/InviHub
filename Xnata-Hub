local panelDragging, panelPointer, panelStart, panelBase = false,nil,nil,nil
on(header.InputBegan,function(input)
    local mouse = input.UserInputType == Enum.UserInputType.MouseButton1
    local touch = input.UserInputType == Enum.UserInputType.Touch
    if not (mouse or touch) then return end
    if input.Position.X > header.AbsolutePosition.X + header.AbsoluteSize.X - 83 then return end
    panelDragging=true
    panelPointer=touch and input or nil
    panelStart=input.Position
    panelBase=panel.Position
end)
