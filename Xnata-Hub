local function normalizeKey(value)
    local key=tostring(value or ""):gsub("^%s+", ""):gsub("%s+$", "")
    -- Migra chaves antigas Invi- para o novo prefixo Xnata-.
    if key:sub(1,5)=="Invi-" then key="Xnata-"..key:sub(6) end
    return key
end
local function getClaim(value)
    local claim=keyClaims[value]
    if claim==nil then claim=keyClaims[tostring(value):gsub("^Xnata-","Invi-")] end
    if type(claim)=="table" then return claim end
    if type(claim)=="number" then return {userId=claim} end
    return nil
end
local function isKeyAllowed(value)
    value=normalizeKey(value)
    local plan=KEY_LIST[value]
    if not plan then return false, "Key invalida ou descontinuada." end
    local claim=getClaim(value)
    if claim and claim.userId and tostring(claim.userId)~=tostring(player.UserId) then
        return false, "Key utilizada por outra conta neste armazenamento."
    end
    if claim and plan=="monthly" and tonumber(claim.expiresAt) and os.time()>=tonumber(claim.expiresAt) then
        return false, "Key mensal expirada. Solicite outra key."
    end
    return true, value
end
local function recordLocalClaim(value)
    local plan=KEY_LIST[value]
    if not plan then return false end
    local claim=getClaim(value)
    if not claim then
        claim={userId=player.UserId,firstUsed=os.time()}
    end
    if plan=="monthly" then
        claim.firstUsed=tonumber(claim.firstUsed) or os.time()
        claim.expiresAt=tonumber(claim.expiresAt) or (claim.firstUsed+MONTH_SECONDS)
    end
    keyClaims[value]=claim
    if not keyWriter then return false end
    return pcall(function()
        keyWriter(CLAIMS_FILE,HttpServiceGlobal:JSONEncode(keyClaims))
    end)
end
local function keyNotice(value)
    if KEY_LIST[value]=="monthly" then
        local claim=getClaim(value)
        if claim and claim.expiresAt then
            return "KEY MENSAL: ATE "..os.date("!%d/%m/%Y",claim.expiresAt)
        end
        return "KEY MENSAL: 30 DIAS (SALVAMENTO INDISPONIVEL)"
    end
    return "KEY LIFETIME VALIDADA"
end
