local SETTINGS_FILE="Xnata_Settings_"..tostring(player.UserId).."_"..tostring(game.PlaceId)..".json"
local previous = env.InvHubSettings
if type(previous) ~= "table" then previous = {} end
if settingsReader then
    pcall(function()
        local saved=SettingsHttpService:JSONDecode(settingsReader(SETTINGS_FILE))
        if type(saved)=="table" then
            for key,value in pairs(saved) do previous[key]=value end
        end
    end)
end
env.InvHubSettings=previous
env.XnataSettings=previous
local transparency = math.clamp(tonumber(previous.transparency) or 0, 0, 70)
local THEME_VERSION = 3
local customHex = (previous.themeVersion == THEME_VERSION and type(previous.hex) == "string") and previous.hex or "#100817"
local toggleKey = (type(previous.key) == "string" and Enum.KeyCode[previous.key]) or Enum.KeyCode.K
if toggleKey==Enum.KeyCode.G then toggleKey=Enum.KeyCode.K end
if not toggleKey or toggleKey == Enum.KeyCode.Unknown then toggleKey = Enum.KeyCode.K end
local isMobile = UIS.TouchEnabled and not UIS.KeyboardEnabled
local resumeAtDeath = previous.respawnDeath==true
local function saveSettings()
    local settings = type(env.InvHubSettings)=="table" and env.InvHubSettings or {}
    settings.transparency = transparency
    settings.hex = customHex
    settings.themeVersion = THEME_VERSION
    settings.key = toggleKey.Name
    settings.respawnDeath = resumeAtDeath
    env.InvHubSettings = settings
    env.XnataSettings = settings
    return settings
end
local function persistSettings()
    local settings=saveSettings()
    if not settingsWriter then return false,"writefile indisponível neste executor." end
    local encoded,payload=pcall(function() return SettingsHttpService:JSONEncode(settings) end)
    if not encoded then return false,"Não foi possível preparar as configurações para salvar." end
    local ok,err=pcall(function() settingsWriter(SETTINGS_FILE,payload) end)
    if not ok then return false,tostring(err) end
    if settingsReader then
        local readOK,check=pcall(settingsReader,SETTINGS_FILE)
        if not readOK or check~=payload then return false,"não foi possível verificar o arquivo salvo." end
    end
    return true,"Configurações salvas neste dispositivo."
end
local function parseHex(str)
    local s = tostring(str or ""):gsub("%s+", ""):gsub("^#", "")
    if #s ~= 6 or not s:match("^%x%x%x%x%x%x$") then return nil end
    return Color3.fromRGB(tonumber(s:sub(1,2),16), tonumber(s:sub(3,4),16), tonumber(s:sub(5,6),16))
end
local function mix(a, b, p)
    return a:Lerp(b, p)
end

