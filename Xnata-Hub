local remoteStorage=game:GetService("ReplicatedStorage")
local function remote()
    local folder=remoteStorage:FindFirstChild("Remotes")
    local evt=folder and folder:FindFirstChild("Polichinelos")
    return (evt and evt:IsA("RemoteEvent")) and evt or nil
end
local function waitActivityRemote()
    local folder=remoteStorage:FindFirstChild("Remotes") or remoteStorage:WaitForChild("Remotes",8)
    local evt=folder and (folder:FindFirstChild("Polichinelos") or folder:WaitForChild("Polichinelos",8))
    return (evt and evt:IsA("RemoteEvent")) and evt or nil
end
local function activeActivity()
    local value=player:GetAttribute("AtividadeFisica")
    if type(value)=="string" and value~="" then return value end
    return nil
end
local function serverCount()
    local n=tonumber(player:GetAttribute("AtividadeFisicaContagem")) or 0
    return math.max(0,math.floor(n))
end
