local originalPromptDurations={}
local function applyInstantPrompt(prompt)
 if not prompt or not prompt:IsA("ProximityPrompt") then return end
 if instantPromptOn then
  if originalPromptDurations[prompt]==nil then originalPromptDurations[prompt]=prompt.HoldDuration end
  if prompt.HoldDuration~=0 then prompt.HoldDuration=0 end
 else
  local original=originalPromptDurations[prompt]
  if original~=nil then
   pcall(function()prompt.HoldDuration=original end)
   originalPromptDurations[prompt]=nil
  end
 end
end
local function setInstantPrompt(value,persist)
