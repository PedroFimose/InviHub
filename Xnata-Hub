    if not panelDragging or not panelStart then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement and not panelPointer
        or input.UserInputType == Enum.UserInputType.Touch and input == panelPointer then
        local delta=(input.Position-panelStart)/scale.Scale
        panel.Position=UDim2.new(panelBase.X.Scale,panelBase.X.Offset+delta.X,
            panelBase.Y.Scale,panelBase.Y.Offset+delta.Y)
        syncShadow()
    end
end)
on(UIS.InputEnded,function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 and not panelPointer
        or input.UserInputType == Enum.UserInputType.Touch and input == panelPointer then
        panelDragging=false
        panelPointer=nil
    end
end)

