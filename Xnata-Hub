local savedYaw, desiredYaw = nil, nil
local rotationToken = 0
local changedHumanoid, priorAutoRotate = nil, nil
local function rootAndHum()
    local char = player.Character
    if not char then return nil, nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then return nil, nil end
    return root, hum
end
local function yawOf(root)
    local look = root.CFrame.LookVector
    return math.atan2(-look.X, -look.Z)
end
local function acquire(hum)
    if changedHumanoid and changedHumanoid ~= hum then
        pcall(function() changedHumanoid.AutoRotate = priorAutoRotate end)
        changedHumanoid, priorAutoRotate = nil, nil
    end
    if not changedHumanoid then
        changedHumanoid, priorAutoRotate = hum, hum.AutoRotate
    end
    hum.AutoRotate = false
end
local function stopRotation(restore)
    rotationToken = rotationToken + 1
    if restore and changedHumanoid then
        pcall(function() changedHumanoid.AutoRotate = priorAutoRotate end)
        changedHumanoid, priorAutoRotate = nil, nil
    end
end
local function rotateTo(goal, message)
    local root, hum = rootAndHum()
    if not root then vStatus.Text = "Personagem ainda não está pronto."; return end
    acquire(hum)
    stopRotation(false)
    local myToken = rotationToken
    local start = yawOf(root)
    local delta = math.atan2(math.sin(goal - start), math.cos(goal - start))
    local duration = 0.27
    local started = os.clock()
    vStatus.Text = message
    task.spawn(function()
        while alive and myToken == rotationToken do
            if not root.Parent or hum.Health <= 0 or player.Character ~= root.Parent then break end
            local a = math.clamp((os.clock() - started) / duration, 0, 1)
            local eased = a * a * (3 - 2 * a)
            local yaw = start + delta * eased
            -- Usar a posição ATUAL a cada frame evita teleporte durante o giro.
            root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, yaw, 0)
            if a >= 1 then break end
            RunService.RenderStepped:Wait()
        end
    end)
end
local function saveVanguard()
    local root = rootAndHum()
    if not root then vStatus.Text = "Entre no jogo e aguarde o personagem."; return end
    stopRotation(true)
    savedYaw = yawOf(root)
    desiredYaw = savedYaw
    vStatus.Text = "Vanguarda salva! Este é o rumo inicial."
end
on(saveBtn.Activated, saveVanguard)
local function turn(amount, name)
    if not savedYaw then vStatus.Text = "Primeiro clique em SALVAR VANGUARDA."; return end
    local root = rootAndHum()
    if not root then vStatus.Text = "Personagem indisponível."; return end
    desiredYaw = (desiredYaw or yawOf(root)) + math.rad(amount)
    rotateTo(desiredYaw, name)
end
