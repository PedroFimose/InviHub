missionPage.CanvasSize=UDim2.fromOffset(0,510)

local missionType=nil
local missionToken=0
local missionHome=nil
local missionCharacter=nil
local missionGhost=nil
local hiddenParts={}
-- Ultima tentativa por objeto: evita repetir a mesma coleta sem parar,
-- mas libera uma nova tentativa quando ele reaparece ou o intervalo expira.
local missionVisited=setmetatable({}, {__mode="k"})
local TRASH_RETRY_SECONDS=14
local GRASS_RETRY_SECONDS=11
local MISSION_SCAN_SECONDS=1.2

local function setMissionStatus(message)
    if missionStatus and missionStatus.Parent then missionStatus.Text=tostring(message) end
end
local function refreshMissionButtons()
    trashButton.Text=missionType=="trash" and "DESATIVAR MISSÃO" or "ATIVAR MISSÃO"
    grassButton.Text=missionType=="grass" and "DESATIVAR MISSÃO" or "ATIVAR MISSÃO"
    trashButton.BackgroundColor3=missionType=="trash" and COLOR.green or COLOR.input
    grassButton.BackgroundColor3=missionType=="grass" and COLOR.green or COLOR.input
end
local function currentMissionCharacter()
    local char=player.Character
    if not char then return nil,nil,nil end
    local root=char:FindFirstChild("HumanoidRootPart")
    local hum=char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health<=0 then return nil,nil,nil end
    return char,root,hum
end
local function rootPartFor(inst)
    if inst:IsA("BasePart") then return inst end
    return inst:FindFirstChildWhichIsA("BasePart",true)
end
local function promptInside(inst)
    if inst:IsA("ProximityPrompt") then return inst end
    return inst:FindFirstChildWhichIsA("ProximityPrompt",true)
end
local function matchingObjects(name,needPrompt)
    local result={}
    for _,inst in ipairs(workspace:GetDescendants()) do
        if inst.Name:lower()==name and not (missionGhost and inst:IsDescendantOf(missionGhost)) then
            local p=rootPartFor(inst)
            if p and (not needPrompt or promptInside(inst)) then
                result[#result+1]=inst
            end
        end
    end
    return result
end
local function closestTarget(name,root,used,needPrompt)
    local best,bestDist=nil,math.huge
    local now=os.clock()
    for _,obj in ipairs(matchingObjects(name,needPrompt)) do
        local part=rootPartFor(obj)
        local prompt=promptInside(obj)
        if part and obj:IsDescendantOf(workspace) and (not prompt or prompt.Enabled) then
            local cooldown=used and used[obj]
            -- Tabelas de cooldown são usadas nas missões; outras chamadas
            -- passam {} para localizar uma lixeira ou a Foice imediatamente.
            local ready=true
            if type(cooldown)=="table" then
                ready=now>=(cooldown.retryAt or 0)
                -- Alguns objetos desabilitam o prompt após a coleta e o
                -- reabilitam ao reaparecer: nesse caso, libere na hora.
                if cooldown.promptWasDisabled and prompt and prompt.Enabled then
                    ready=true
                end
            elseif cooldown then
                ready=false
            end
            if ready then
                local d=(root.Position-part.Position).Magnitude
                if d<bestDist then best,bestDist=obj,d end
            end
        end
    end
    return best
end
local function delayMissionTarget(obj,kind)
    if not obj then return end
    local prompt=promptInside(obj)
    missionVisited[obj]={
        retryAt=os.clock()+(kind=="trash" and TRASH_RETRY_SECONDS or GRASS_RETRY_SECONDS),
        promptWasDisabled=(prompt~=nil and not prompt.Enabled),
    }
end
local function activeMission(token,kind)
    return alive and missionToken==token and missionType==kind
end
local function approachForMission(obj,token,kind)
    if not activeMission(token,kind) then return false end
    local char,root=currentMissionCharacter()
    local part=obj and rootPartFor(obj)
    if not char or char~=missionCharacter or not root or not part then return false end
    local pos=part.Position
    -- Deslocamento local de teste. Pode ser corrigido pelo servidor.
    local facing=Vector3.new(root.Position.X-pos.X,0,root.Position.Z-pos.Z)
    if facing.Magnitude<.05 then facing=Vector3.new(0,0,1) end
    local destination=pos+facing.Unit*2.8+Vector3.new(0,1.8,0)
    pcall(function()
        root.AssemblyLinearVelocity=Vector3.zero
        root.AssemblyAngularVelocity=Vector3.zero
        root.CFrame=CFrame.lookAt(destination,Vector3.new(pos.X,destination.Y,pos.Z))
    end)
    task.wait(.25)
    return activeMission(token,kind) and root.Parent~=nil
end
local function activatePrompt(prompt,token,kind)
    if not prompt or not activeMission(token,kind) then return false,"Prompt indisponível." end
    if not prompt.Enabled then return false,"Prompt desativado." end
    -- fireproximityprompt nao e API oficial; o executor pode nao disponibilizar.
    local fn=nil
    pcall(function()
        fn=type(fireproximityprompt)=="function" and fireproximityprompt or nil
        if not fn and type(env.fireproximityprompt)=="function" then fn=env.fireproximityprompt end
    end)
    if fn then
        local ok=pcall(function()fn(prompt)end)
        if ok then return true,"Interação solicitada." end
    end
    local ok=pcall(function()
        prompt:InputHoldBegin()
        task.wait(math.max(.15,tonumber(prompt.HoldDuration) or 0)+.1)
        prompt:InputHoldEnd()
    end)
    return ok,ok and "Interação solicitada." or "O cliente não conseguiu acionar o prompt."
end
local function equippedFoice()
    local char=player.Character
    local bag=player:FindFirstChildOfClass("Backpack")
    for _,p in ipairs({char,bag}) do
        if p then
            for _,v in ipairs(p:GetChildren()) do
                if v:IsA("Tool") and v.Name:lower():find("foice",1,true) then return v end
            end
        end
    end
    return nil
end
local function moneyValue()
    local containers={}
    local stats=player:FindFirstChild("leaderstats")
    if stats then containers[#containers+1]=stats end
    containers[#containers+1]=player
    for _,holder in ipairs(containers) do
        if holder then
            for _,value in ipairs(holder:GetDescendants()) do
                if value:IsA("IntValue") or value:IsA("NumberValue") then
                    local key=value.Name:lower()
                    if key=="dinheiro" or key=="money" or key=="cash" or key=="r$" or key=="moedas" then
                        return value.Value
                    end
                end
            end
        end
    end
    return nil
end
local function ensureFoice(token)
    if equippedFoice() then return true end
    local balance=moneyValue()
    if balance and balance<2500 then
        setMissionStatus("Capinagem: saldo insuficiente para a Foice (R$ 2.500).")
        return false
    end
    local _,root=currentMissionCharacter()
    if not root then return false end
    local foice=closestTarget("foice",root,{},true)
    if not foice then
        setMissionStatus("Foice não encontrada no mapa. Compre/equipe manualmente.")
        return false
    end
    if not approachForMission(foice,token,"grass") then return false end
    local ok=activatePrompt(promptInside(foice),token,"grass")
    if not ok then setMissionStatus("Não foi possível solicitar a compra da Foice.");return false end
    setMissionStatus("Solicitada a Foice; verificando compra/equipamento...")
    for _=1,18 do
        if not activeMission(token,"grass") then return false end
        if equippedFoice() then return true end
        task.wait(.25)
    end
    setMissionStatus("A Foice não apareceu no inventário. Compra não confirmada.")
    return false
end
local function createLocalGhost(char)
    -- Isto NAO replica para outros jogadores.
    local ghost=nil
    local original=char.Archivable
    local ok=pcall(function()
        char.Archivable=true
        ghost=char:Clone()
        char.Archivable=original
    end)
    char.Archivable=original
    if not ok or not ghost then return end
    ghost.Name="Xnata_Missao_Clone_Local"
    for _,obj in ipairs(ghost:GetDescendants()) do
        if obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("ModuleScript") or obj:IsA("Tool") then
            obj:Destroy()
        elseif obj:IsA("BasePart") then
            obj.Anchored=true
            obj.CanCollide=false
            obj.CanTouch=false
            obj.CanQuery=false
        elseif obj:IsA("ProximityPrompt") then
            obj.Enabled=false
        end
    end
    ghost.Parent=workspace
    missionGhost=ghost
end
local function hideLocalBody(char)
    for _,obj in ipairs(char:GetDescendants()) do
        if obj:IsA("BasePart") then
            hiddenParts[obj]=obj.LocalTransparencyModifier
            obj.LocalTransparencyModifier=1
        end
    end
end
local function restoreLocalBody()
    for part,value in pairs(hiddenParts) do
        if part and part.Parent then pcall(function()part.LocalTransparencyModifier=value end) end
    end
    table.clear(hiddenParts)
end
local function missionsStop(message)
    missionToken=missionToken+1
    local wasActive=missionType~=nil
    missionType=nil
    if wasActive and missionHome and missionCharacter==player.Character then
        local _,root=currentMissionCharacter()
        if root then pcall(function()root.CFrame=missionHome end) end
    end
    restoreLocalBody()
    if missionGhost then pcall(function()missionGhost:Destroy()end);missionGhost=nil end
    missionHome=nil
    missionCharacter=nil
    missionVisited=setmetatable({}, {__mode="k"})
    refreshMissionButtons()
    setMissionStatus(message or "Missão desativada.")
end

local function garbageLoop(token)
    local attempted=0
    while activeMission(token,"trash") do
        local char,root=currentMissionCharacter()
        if not char or char~=missionCharacter or not root then
            setMissionStatus("Coleta: aguardando o personagem ficar disponível...")
            task.wait(MISSION_SCAN_SECONDS)
        else
            local item=closestTarget("lixo",root,missionVisited,true)
            if not item then
                setMissionStatus("Coleta ativa: "..attempted.." entregas tentadas. Aguardando lixo novo ou reaparecimento...")
                task.wait(MISSION_SCAN_SECONDS)
            else
                -- Não marcar permanentemente: após o intervalo, o mesmo
                -- objeto pode ser revisto se o jogo o disponibilizar de novo.
                delayMissionTarget(item,"trash")
                local prompt=promptInside(item)
                if approachForMission(item,token,"trash") then
                    local ok=activatePrompt(prompt,token,"trash")
                    if ok and activeMission(token,"trash") then
                        task.wait(.35)
                        local _,nearRoot=currentMissionCharacter()
                        local bin=nearRoot and closestTarget("lixeira",nearRoot,{},true)
                        if bin and approachForMission(bin,token,"trash") then
                            activatePrompt(promptInside(bin),token,"trash")
                            attempted=attempted+1
                            setMissionStatus("Coleta ativa: "..attempted.." entregas tentadas. Monitorando novos lixos...")
                        else
                            setMissionStatus("Coleta ativa: esperando lixeira disponível...")
                        end
                    else
                        setMissionStatus("Coleta ativa: interação com lixo não confirmada; tentando novamente depois...")
                    end
                end
                task.wait(.35)
            end
        end
    end
end
local function grassLoop(token)
    local attempted=0
    while activeMission(token,"grass") do
        local char,root,hum=currentMissionCharacter()
        if not char or char~=missionCharacter or not root then
            setMissionStatus("Capinagem: aguardando o personagem ficar disponível...")
            task.wait(MISSION_SCAN_SECONDS)
        elseif not equippedFoice() then
            -- Não encerrar a missão se a Foice ainda não estiver disponível:
            -- rechecagem periódica, com intervalo para não repetir compras.
            setMissionStatus("Capinagem ativa: aguardando Foice/equipamento...")
            if ensureFoice(token) and activeMission(token,"grass") then
                setMissionStatus("Capinagem: Foice equipada. Procurando grama...")
            end
            task.wait(4)
        else
            local grass=closestTarget("grama",root,missionVisited,false)
            if not grass then
                setMissionStatus("Capinagem ativa: "..attempted.." plantas visitadas. Aguardando grama nova ou reaparecimento...")
                task.wait(MISSION_SCAN_SECONDS)
            else
                delayMissionTarget(grass,"grass")
                if approachForMission(grass,token,"grass") then
                    local tool=equippedFoice()
                    if tool then
                        pcall(function()hum:EquipTool(tool)end)
                        task.wait(.15)
                        if activeMission(token,"grass") then
                            local prompt=promptInside(grass)
                            if prompt then
                                activatePrompt(prompt,token,"grass")
                            else
                                -- Sem confirmação de corte: o jogo pode usar
                                -- uma validação própria do servidor.
                                pcall(function()tool:Activate()end)
                            end
                            attempted=attempted+1
                            setMissionStatus("Capinagem ativa: "..attempted.." plantas visitadas. Procurando mais grama...")
                        end
                    else
                        setMissionStatus("Capinagem ativa: Foice indisponível; aguardando...")
                    end
                end
                task.wait(.45)
            end
        end
    end
end
local function startMission(kind)
    if missionType==kind then missionsStop("Missão interrompida.");return end
    if missionType then missionsStop("Trocando de missão...") end
    local char,root=currentMissionCharacter()
    if not char then setMissionStatus("Aguarde o personagem renascer.");return end
    missionType=kind
    missionToken=missionToken+1
    local token=missionToken
    missionCharacter=char
    missionHome=root.CFrame
    missionVisited=setmetatable({}, {__mode="k"})
    createLocalGhost(char)
    hideLocalBody(char)
    refreshMissionButtons()
    setMissionStatus(kind=="trash" and "Coletando lixo..." or "Preparando capinagem...")
    task.spawn(function()
        -- Erros pontuais não desligam a missão. O usuário controla o término
        -- pelo botão DESATIVAR; cada reinício espera para evitar loop ocupado.
        while activeMission(token,kind) do
            local ok,err=pcall(function()
                if kind=="trash" then garbageLoop(token) elseif kind=="grass" then grassLoop(token) end
            end)
            if activeMission(token,kind) then
                if not ok then
                    warn("[Xnata Missões] "..tostring(err))
                    setMissionStatus("Missão ativa: erro temporário; nova tentativa em 3 s.")
                end
                task.wait(3)
            end
        end
    end)
end
on(trashButton.Activated,function()startMission("trash")end)
on(grassButton.Activated,function()startMission("grass")end)
on(player.CharacterAdded,function(newChar)
    if not missionType then return end
    local token=missionToken
    -- Continuar após renascimento, mas só quando o novo personagem tiver
    -- humanoide e HumanoidRootPart. Não criar dois loops de missão.
    task.spawn(function()
        local root=newChar:WaitForChild("HumanoidRootPart",12)
        local hum=newChar:WaitForChild("Humanoid",12)
        if not root or not hum or hum.Health<=0 or token~=missionToken or not missionType then return end
        restoreLocalBody()
        if missionGhost then pcall(function()missionGhost:Destroy()end);missionGhost=nil end
        missionCharacter=newChar
        missionHome=root.CFrame
        createLocalGhost(newChar)
        hideLocalBody(newChar)
        setMissionStatus("Missão ativa: personagem renasceu; retomando procura...")
    end)
end)
-- Chamado tambem no encerramento geral do menu.
return missionsStop
end)()

