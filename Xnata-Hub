local function show(visible)
    -- Nenhum botao flutuante no PC.
    bubble.Visible = (not visible) and isMobile
    if not visible then
        panel.Visible, shadow.Visible = false, false
        return
    end
    local p = panel.Position
    local sh = shadow.Position
    local targetScale = fittedScale
    local targetShadowScale = fittedScale
    local duration = .34
    panel.Position = UDim2.new(p.X.Scale, p.X.Offset, p.Y.Scale, p.Y.Offset + 13)
    shadow.Position = UDim2.new(sh.X.Scale, sh.X.Offset, sh.Y.Scale, sh.Y.Offset + 13)
    scale.Scale = targetScale * .89
    shadowScale.Scale = targetShadowScale * .89
    panel.Visible, shadow.Visible = true, true
    local info = TweenInfo.new(duration, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    TweenService:Create(scale, info, {Scale=targetScale}):Play()
    TweenService:Create(shadowScale, info, {Scale=targetShadowScale}):Play()
    TweenService:Create(panel, info, {Position=p}):Play()
    TweenService:Create(shadow, info, {Position=sh}):Play()
end
