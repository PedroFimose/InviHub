local function restoreHitbox(pl)
 local saved=hitboxOriginals[pl]
 if not saved then return end
 hitboxOriginals[pl]=nil
 local root=saved.root
 if root and root.Parent then
  pcall(function()
   root.Size=saved.size
   root.Transparency=saved.transparency
   root.Color=saved.color
   root.CanCollide=saved.canCollide
   root.CustomPhysicalProperties=saved.customPhysicalProperties
  end)
 end
end
local function restoreAllHitboxes()
 for pl in pairs(hitboxOriginals) do restoreHitbox(pl) end
end
local function refreshHitboxes()
 if not hitboxOn then
  restoreAllHitboxes()
  return
 end
 for _,other in ipairs(Players:GetPlayers()) do
  if other~=player then
   local character=other.Character
   local humanoid=character and character:FindFirstChildOfClass("Humanoid")
   local root=character and character:FindFirstChild("HumanoidRootPart")
   if humanoid and humanoid.Health>0 and root and root:IsA("BasePart") then
    local saved=hitboxOriginals[other]
    if not saved or saved.root~=root then
     restoreHitbox(other)
     hitboxOriginals[other]={
      root=root,
      size=root.Size,
      transparency=root.Transparency,
      color=root.Color,
      canCollide=root.CanCollide,
      customPhysicalProperties=root.CustomPhysicalProperties,
     }
    end
    pcall(function()
     root.Size=Vector3.new(hitboxSize,hitboxSize,hitboxSize)
     root.Transparency=hitboxAlpha/100
     root.Color=XNATA_PURPLE
     root.CanCollide=false
     root.CustomPhysicalProperties=PhysicalProperties.new(0,0,0,0,0)
    end)
   else
    restoreHitbox(other)
   end
  end
 end
 for other in pairs(hitboxOriginals) do
  if not other.Parent then restoreHitbox(other) end
 end
end

