local lastChatSend=0
local function sendToChat(message)
    if os.clock()-lastChatSend < 1.3 then
        notice("Aguarde antes de enviar outra mensagem.")
        return
    end
    lastChatSend=os.clock()
    task.spawn(function()
        local sent=false
        local why="Chat indisponível neste jogo."
        if TextChatService.ChatVersion==Enum.ChatVersion.TextChatService then
            local channels=TextChatService:FindFirstChild("TextChannels")
            local general=channels and channels:FindFirstChild("RBXGeneral")
            if general and general:IsA("TextChannel") then
                local ok,err=pcall(function() general:SendAsync(message) end)
                sent=ok
                if not ok then why=tostring(err) end
            else
                why="Canal RBXGeneral não encontrado."
            end
        else
            local events=game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
            local say=events and events:FindFirstChild("SayMessageRequest")
            if say and say:IsA("RemoteEvent") then
                local ok,err=pcall(function() say:FireServer(message,"All") end)
                sent=ok
                if not ok then why=tostring(err) end
            else
                why="O jogo não expõe o chat padrão."
            end
        end
        if not alive then return end
        if sent then
            notice("Envio solicitado ao chat. Sujeito às regras do jogo.")
        else
            notice("Envio indisponível neste chat.")
            warn("[Xnata TAFs] "..why)
        end
    end)
end

