local tintProps={"BackgroundColor3","TextColor3","ImageColor3","ScrollBarImageColor3","Color"}
local function recolor(old)
    -- Manter as cores de estado dos botoes ja existentes.
    for _, object in ipairs(gui:GetDescendants()) do
        if object ~= bubble and not object:IsDescendantOf(bubble) then
        for _, property in ipairs(tintProps) do
            local ok, value=pcall(function() return object[property] end)
            if ok and typeof(value)=="Color3" then
                for role, previousColor in pairs(old) do
                    if value == previousColor then
                        pcall(function() object[property]=COLOR[role] end)
                        break
                    end
                end
            end
        end
        end
    end
end
local function theme(base)
    local old=table.clone(COLOR)
    local luminance=base.R*.2126+base.G*.7152+base.B*.0722
    local light=luminance>.56
    local fg=light and Color3.fromRGB(27,29,32) or Color3.fromRGB(239,240,242)
    local toward=light and Color3.new(0,0,0) or Color3.new(1,1,1)
    local purpleTheme=base.B>base.G*1.25 and base.R>base.G*1.15 and base.B>base.R*.85
    COLOR.bg=base
    if purpleTheme then
        COLOR.sidebar=Color3.fromRGB(24,16,31)
        COLOR.card=Color3.fromRGB(36,29,43)
        COLOR.input=Color3.fromRGB(29,21,36)
        COLOR.border=Color3.fromRGB(67,55,74)
        COLOR.white=Color3.fromRGB(239,240,242)
        COLOR.faded=Color3.fromRGB(166,158,174)
        COLOR.accent=XNATA_PURPLE
        COLOR.green=Color3.fromRGB(59,37,78)
        COLOR.red=Color3.fromRGB(76,39,65)
        COLOR.dimGreen=Color3.fromRGB(39,26,51)
        COLOR.dimRed=Color3.fromRGB(48,29,43)
    else
        COLOR.sidebar=mix(base,toward,.035)
        COLOR.card=mix(base,toward,.087)
        COLOR.input=mix(base,toward,.145)
        COLOR.border=mix(base,toward,.235)
        COLOR.white=fg
        COLOR.faded=mix(fg,base,.39)
        COLOR.accent=mix(fg,base,.10)
        COLOR.green=mix(base,toward,.34)
        COLOR.red=mix(base,toward,.25)
        COLOR.dimGreen=mix(base,toward,.19)
        COLOR.dimRed=mix(base,toward,.21)
    end
    recolor(old)
end
