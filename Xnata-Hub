 for _,obj in ipairs(workspace:GetDescendants()) do
  if obj:IsA("ProximityPrompt") then applyInstantPrompt(obj) end
 end
 if persist~=false then
  settings.instantPrompt=instantPromptOn
  saveSettings()
 end
end
for _,obj in ipairs(workspace:GetDescendants()) do
 if obj:IsA("ProximityPrompt") then
  on(obj:GetPropertyChangedSignal("HoldDuration"),function()
   if instantPromptOn and obj.Parent and obj.HoldDuration>0 then applyInstantPrompt(obj) end
  end)
  applyInstantPrompt(obj)
 end
end
on(workspace.DescendantAdded,function(obj)
