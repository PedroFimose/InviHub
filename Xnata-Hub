local bubbleDrag, bubblePointer, bubbleStart, bubbleBase, bubbleMoved = false,nil,nil,nil,false
on(bubble.InputBegan,function(input)
    local touch = input.UserInputType == Enum.UserInputType.Touch
    if touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        bubbleDrag=true
        bubblePointer=touch and input or nil
        bubbleStart=input.Position
        bubbleBase=bubble.AbsolutePosition
        bubbleMoved=false
    end
end)
on(UIS.InputChanged,function(input)
    if not bubbleDrag or not bubbleStart then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement and not bubblePointer
        or input.UserInputType == Enum.UserInputType.Touch and input == bubblePointer then
        local delta = input.Position - bubbleStart
        if delta.Magnitude > 7 then bubbleMoved=true end
        if bubbleMoved then
            local camera=workspace.CurrentCamera
            if not camera then return end
            local vp=camera.ViewportSize
            local x=math.clamp(bubbleBase.X + delta.X,4,math.max(4,vp.X - bubble.AbsoluteSize.X - 4))
            local y=math.clamp(bubbleBase.Y + delta.Y,4,math.max(4,vp.Y - bubble.AbsoluteSize.Y - 4))
            bubble.Position=UDim2.fromOffset(x,y)
        end
    end
end)
on(UIS.InputEnded,function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 and not bubblePointer
        or input.UserInputType == Enum.UserInputType.Touch and input == bubblePointer then
        bubbleDrag=false
        bubblePointer=nil
    end
end)
