on(UIS.InputBegan,function(input)
    if not captureKey or input.UserInputType~=Enum.UserInputType.Keyboard then return end
    local key=input.KeyCode
    justCapturedBindKey=key.Name
    justCapturedBindUntil=os.clock()+.2
    if key==Enum.KeyCode.Escape then
        captureKey=false
    elseif key==Enum.KeyCode.G or key==Enum.KeyCode.Q or key==Enum.KeyCode.E
        or key==Enum.KeyCode.W or key==Enum.KeyCode.A or key==Enum.KeyCode.S or key==Enum.KeyCode.D
        or key==Enum.KeyCode.Space or key==Enum.KeyCode.LeftControl then
        captureKey=false
        keyBtn.Text="Alterar tecla"
        keyInfo.Text="Essa tecla é reservada. Atual: "..toggleKey.Name
        return
    elseif key~=Enum.KeyCode.Unknown then
        local st=type(env.InvHubSettings)=="table" and env.InvHubSettings or {}
        local used=st.aimBind==key.Name
        if type(st.parkourBinds)=="table" then
            for _,name in pairs(st.parkourBinds) do if name==key.Name then used=true end end
        end
        if used then
            captureKey=false
            keyBtn.Text="Alterar tecla"
            keyInfo.Text="Essa tecla já está vinculada a outra função."
            return
        end
        toggleKey=key
        captureKey=false
        saveSettings()
    else
        return
    end
    keyBtn.Text="Alterar tecla"
    keyInfo.Text="Atual: "..toggleKey.Name
end)

