local function teleportToScreenPoint(screenPosition)
 local cam=workspace.CurrentCamera
 local ch=player.Character
 local root=ch and ch:FindFirstChild("HumanoidRootPart")
 local hum=ch and ch:FindFirstChildOfClass("Humanoid")
 if not cam or not root or not hum or hum.Health<=0 then return false,"Personagem indisponível." end
 local ray=cam:ScreenPointToRay(screenPosition.X,screenPosition.Y)
 local params=RaycastParams.new()
 params.FilterType=Enum.RaycastFilterType.Exclude
 params.FilterDescendantsInstances={ch}
 local result=workspace:Raycast(ray.Origin,ray.Direction*3000,params)
 if not result then return false,"Nenhuma superfície encontrada nesse ponto." end
 local rotation=root.CFrame-root.Position
 root.CFrame=CFrame.new(result.Position+Vector3.new(0,3,0))*rotation
 return true,"Teleport local solicitado. O servidor pode corrigir a posição."
end
