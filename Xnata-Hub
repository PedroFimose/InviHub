local function attachDrag(frame,handle)
 local held=false
 local startInput,basePos,touchInput=nil,nil,nil
 on(handle.InputBegan,function(input)
  if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
   held=true;startInput=input.Position;basePos=frame.Position
   touchInput=input.UserInputType==Enum.UserInputType.Touch and input or nil
  end
 end)
 on(UIS.InputChanged,function(input)
  if not held or not startInput then return end
  if (not touchInput and input.UserInputType==Enum.UserInputType.MouseMovement) or (touchInput and input==touchInput) then
   local delta=input.Position-startInput
   frame.Position=UDim2.new(basePos.X.Scale,basePos.X.Offset+delta.X,basePos.Y.Scale,basePos.Y.Offset+delta.Y)
  end
 end)
 on(UIS.InputEnded,function(input)
  if (not touchInput and input.UserInputType==Enum.UserInputType.MouseButton1) or (touchInput and input==touchInput) then held=false;touchInput=nil end
 end)
end
