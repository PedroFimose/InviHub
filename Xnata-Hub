local function pointInsideMainMenu(point)
 if not panel.Visible then return false end
 local pos,size=panel.AbsolutePosition,panel.AbsoluteSize
 return point.X>=pos.X and point.X<=pos.X+size.X and point.Y>=pos.Y and point.Y<=pos.Y+size.Y
end
local function pointOverGui(point)
 local ok,objects=pcall(function()
  return game:GetService("GuiService"):GetGuiObjectsAtPosition(point.X,point.Y)
 end)
 if not ok or type(objects)~="table" then return false end
 for _,obj in ipairs(objects) do
  if obj and obj:IsA("GuiObject") and obj.Visible then return true end
 end
 return false
end
