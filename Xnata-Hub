        task.defer(function()
            if alive and logWindow.Visible and scroll.Parent then
                scroll.CanvasPosition=Vector2.new(0,math.max(0,scroll.CanvasSize.Y.Offset-scroll.AbsoluteSize.Y))
            end
        end)
    end
    local function recordMessage(name,displayName,message,messageID)
        if type(message)~="string" then return end
        if message=="" then
            hiddenMessageCount=hiddenMessageCount+1
            if logWindow.Visible then render() end
            return
        end
        if messageID and messageID~="" then
            if seenIDs[messageID] then return end
            seenIDs[messageID]=true
        end
        entries[#entries+1]={name=tostring(name),displayName=tostring(displayName),
            text=message:sub(1,1200),time=os.date("%H:%M:%S")}
        if #entries>150 then table.remove(entries,1) end
        if logWindow.Visible then render() end
    end
    -- Chat moderno: recebe somente as mensagens entregues e filtradas ao cliente.
    if TextChatService.ChatVersion==Enum.ChatVersion.TextChatService then
        on(TextChatService.MessageReceived,function(msg)
            local source=msg.TextSource
            if not source then return end
            local author=Players:GetPlayerByUserId(source.UserId)
            local name=author and author.Name or "Jogador"
            local displayName=author and author.DisplayName or name
            recordMessage(name,displayName,msg.Text,msg.MessageId)
        end)
    else
        -- Legado: apenas mensagens filtradas que o servidor ja entregou.
        local events=game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
        local filtered=events and events:FindFirstChild("OnMessageDoneFiltering")
        if filtered and filtered:IsA("RemoteEvent") then
            on(filtered.OnClientEvent,function(msg)
                if type(msg)~="table" then return end
                local name=tostring(msg.FromSpeaker or "Jogador")
                local author=Players:FindFirstChild(name)
                recordMessage(name,author and author.DisplayName or name,
                    msg.Message,tostring(msg.ID or ""))
            end)
        end
    end
    on(searchBox:GetPropertyChangedSignal("Text"),render)
    local function setLogsOpen(visible, minimized)
        if not alive or not logGui.Parent then return end
        logWindow.Visible=visible
        restoreLog.Visible=(not visible) and minimized and UIS.TouchEnabled
        if visible then
            fitLogWindow()
            render()
        end
    end
    chatLogHandlers.open=function()
        setLogsOpen(true,false)
    end
    chatLogHandlers.toggle=function()
        setLogsOpen(not logWindow.Visible,logWindow.Visible)
    end
    on(minimizeLog.Activated,function()setLogsOpen(false,true) end)
    on(closeLog.Activated,function()setLogsOpen(false,false) end)
    on(restoreLog.Activated,function()setLogsOpen(true,false) end)
    -- Atalho G exclusivo do Chat Logs. Nao interfere ao digitar no chat ou pesquisa.
    on(UIS.InputBegan,function(input,processed)
        if processed or captureKey or bindCaptureInProgress~=nil or UIS:GetFocusedTextBox() then return end
        if justCapturedBindKey==input.KeyCode.Name and os.clock()<=justCapturedBindUntil then return end
        if input.KeyCode==Enum.KeyCode.G then
            chatLogHandlers.toggle()
        end
    end)

    -- Arrastar pela barra, com mouse ou toque.
    local drag=false
    local dragInput=nil
    local startPos=nil
    local basePos=nil
    on(bar.InputBegan,function(input)
        if input.UserInputType~=Enum.UserInputType.MouseButton1 and
            input.UserInputType~=Enum.UserInputType.Touch then return end
        if input.Position.X>bar.AbsolutePosition.X+bar.AbsoluteSize.X-102 then return end
        drag=true;dragInput=input;startPos=input.Position;basePos=logWindow.Position
    end)
    on(UIS.InputChanged,function(input)
        if not drag or not startPos or not basePos then return end
        if dragInput and dragInput.UserInputType==Enum.UserInputType.Touch and input~=dragInput then return end
        if dragInput and dragInput.UserInputType==Enum.UserInputType.MouseButton1
            and input.UserInputType~=Enum.UserInputType.MouseMovement then return end
        local delta=input.Position-startPos
        local invScale=math.max(.42,logScale.Scale)
        logWindow.Position=UDim2.new(basePos.X.Scale,basePos.X.Offset+delta.X/invScale,
            basePos.Y.Scale,basePos.Y.Offset+delta.Y/invScale)
    end)
    on(UIS.InputEnded,function(input)
        if input==dragInput or (dragInput and dragInput.UserInputType==Enum.UserInputType.MouseButton1
            and input.UserInputType==Enum.UserInputType.MouseButton1) then
            drag=false;dragInput=nil
        end
    end)
    chatLogHandlers.stop=function()
        if logGui and logGui.Parent then logGui:Destroy() end
        table.clear(entries)
        table.clear(seenIDs)
    end


end
