    -- Mostra a duracao da rota gravada; estimativa sem pausas (tempo / velocidade do modo).
    local function formatDuration(seconds)
        if type(seconds)~="number" or seconds~=seconds or seconds<0 then return "--:--" end
        local tenths=math.floor(seconds*10+0.5)
        local minutes=math.floor(tenths/600)
        local wholeSeconds=math.floor(tenths/10)%60
        return string.format("%02d:%02d.%01d",minutes,wholeSeconds,tenths%10)
    end

    local function round(n)
        return math.floor(n*10000+(n>=0 and .5 or -.5))/10000
    end
    local function character()
        local c = player.Character
        if not c then return end
        local h = c:FindFirstChildOfClass("Humanoid")
        local root = c:FindFirstChild("HumanoidRootPart")
        if h and root and h.Health>0 then return h,root end
    end
    local function coord(f)
        return Vector3.new(f[2],f[3],f[4])
    end
    local function pose(f)
        return CFrame.new(f[2],f[3],f[4],f[5],f[6],f[7],f[8],f[9],f[10],f[11],f[12],f[13])
    end
    local function valid(route)
        if type(route)~="table" or route.format~=4 or type(route.frames)~="table" then return false end
        local frames=route.frames
        if #frames<12 or #frames>maxFrames then return false end
        if type(route.duration)~="number" or route.duration<.2 or route.duration>maxDuration+1 then return false end
        local previous=-1
        for _,f in ipairs(frames) do
            if type(f)~="table" or #f~=18 then return false end
            for i=1,18 do
                if type(f[i])~="number" or f[i]~=f[i] or math.abs(f[i])>1000000 then return false end
            end
            if f[1]<previous or f[1]>maxDuration+1 then return false end
            previous=f[1]
        end
        return true
    end
    -- Evitar chaves numericas e texto misturadas no JSON.
    for i=1,4 do for mode=1,maxModeForSlot(i) do
        local k=routeKey(i,mode)
        if valid(previousSessionRoutes[k]) then confirmed[k]=previousSessionRoutes[k] end
    end end
    for i=1,4 do
        local k=routeKey(i,1)
        if valid(previousSessionRoutes[i]) and not valid(confirmed[k]) then
            confirmed[k]=previousSessionRoutes[i]
        end
    end
    -- Recupera gravacoes das torres da mesma sessao quando o hub e reexecutado.
    local towerSession=type(env.InvHubTowersV1)=="table" and env.InvHubTowersV1 or {}
    env.InvHubTowersV1=towerSession
    local savedTowerSession=towerSession[placeKey]
    if type(savedTowerSession)=="table" then
        for n=1,2 do
            if valid(savedTowerSession[n]) then towerConfirmed[n]=savedTowerSession[n] end
        end
    end
    local function importRoutes(incoming, overwrite)
        if type(incoming)~="table" then return end
        for i=1,4 do for mode=1,maxModeForSlot(i) do
            local k=routeKey(i,mode)
            if valid(incoming[k]) and (overwrite or not valid(confirmed[k])) then
                confirmed[k]=incoming[k]
            end
        end end
    end
    if reader then
        pcall(function()
            local data=HttpService:JSONDecode(reader(fileName))
            if tostring(data.placeId)==placeKey then importRoutes(data.routes,false) end
        end)
        -- Migracao: a rota antiga vira somente Sem burla. As demais sao independentes.
        pcall(function()
            local data=HttpService:JSONDecode(reader(legacyFile))
            if tostring(data.placeId)==placeKey and type(data.routes)=="table" then
                for i=1,4 do
                    local k=routeKey(i,1)
                    if valid(data.routes[i]) and not valid(confirmed[k]) then confirmed[k]=data.routes[i] end
                end
            end
        end)
        pcall(function()
            local data=HttpService:JSONDecode(reader(personalFile))
            if tostring(data.placeId)==placeKey and type(data.routes)=="table" then
                for _,entry in ipairs(data.routes) do
                    if type(entry)=="table" and valid(entry.route) and #personalRoutes<30 then
                        local id=tonumber(entry.id) or nextPersonalId
                        nextPersonalId=math.max(nextPersonalId,id+1)
                        table.insert(personalRoutes,{id=id,name=tostring(entry.name or ("Rota "..id)):sub(1,28),route=entry.route})
                    end
                end
            end
        end)
    end
    -- Carregamento de torres isolado do arquivo dos parkours antigos.
    if reader then
        pcall(function()
            local data=HttpService:JSONDecode(reader(towersFile))
            if tostring(data.placeId)==placeKey and type(data.towers)=="table" then
                for n=1,2 do
                    local loaded=data.towers[tostring(n)] or data.towers[n]
                    if valid(loaded) then towerConfirmed[n]=loaded end
                end
            end
        end)
    end
    local function persistParkours()
        if not writer then return false,"writefile indisponivel" end
        local payload=HttpService:JSONEncode({format=4,placeId=game.PlaceId,routes=confirmed})
        local ok,err=pcall(function() writer(fileName,payload) end)
        if not ok then return false,tostring(err) end
        if reader then
            local readOK,check=pcall(reader,fileName)
            if not readOK or check~=payload then return false,"falha na leitura de verificacao" end
        end
        return true,"salvo"
    end
    local function persistTowers()
        towerSession[placeKey]=towerConfirmed
        if not writer then return false end
        return pcall(function()
            writer(towersFile,HttpService:JSONEncode({format=4,placeId=game.PlaceId,towers={
                ["1"]=towerConfirmed[1], ["2"]=towerConfirmed[2]
            }}))
        end)
    end
