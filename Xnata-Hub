-- ===================== BLOQUEIO DE JJS (PC E MOBILE) =====================
-- Impede apenas a interação local do usuário com Q/E/Y/TAP.
-- Não encerra a atividade física do Roblox, mesmo quando para a automação.
-- Limite: scripts que escutam UserInputService diretamente ou eventos do servidor
-- podem ignorar a prioridade do ContextActionService. Não garante bloqueio absoluto.
local ContextActionService = game:GetService("ContextActionService")
local blockActionName="InvHubV1_Block_JJS"
local touchBlockGui=make("ScreenGui",{
    Name="InvHub_JJS_TouchBlock",ResetOnSpawn=false,IgnoreGuiInset=true,
    DisplayOrder=91,Enabled=false,ZIndexBehavior=Enum.ZIndexBehavior.Global,
},pg)
local coverButtons={}
local function releaseBlockTouch()
    for _,cover in pairs(coverButtons) do
        if cover and cover.Parent then cover:Destroy() end
    end
    table.clear(coverButtons)
end
local function syncBlockTouch()
    if not alive or not ActivityControls.isBlocked() or not ActivityControls.getActivity() then
        if touchBlockGui.Enabled then touchBlockGui.Enabled=false;releaseBlockTouch() end
        return
    end
    touchBlockGui.Enabled=true
    local qte=ActivityControls.qteScreen()
    local used={}
    if qte then
        for _,targetButton in ipairs(qte:GetDescendants()) do
            if targetButton:IsA("ImageButton") and targetButton.Visible and ActivityControls.qteLetter(targetButton) then
                used[targetButton]=true
                local cover=coverButtons[targetButton]
                if not cover or not cover.Parent then
                    cover=make("TextButton",{
                        Text="",AutoButtonColor=false,Active=true,Selectable=false,
                        BackgroundTransparency=1,BorderSizePixel=0,ZIndex=100,
                    },touchBlockGui)
                    coverButtons[targetButton]=cover
                    -- O sinal é desconectado automaticamente quando o botão for destruído.
                    cover.Activated:Connect(function() end)
                end
                cover.Visible=true
                cover.Position=UDim2.fromOffset(targetButton.AbsolutePosition.X,targetButton.AbsolutePosition.Y)
                cover.Size=UDim2.fromOffset(targetButton.AbsoluteSize.X,targetButton.AbsoluteSize.Y)
            end
        end
    end
    for original,cover in pairs(coverButtons) do
        if not used[original] then
            if cover.Parent then cover:Destroy() end
            coverButtons[original]=nil
        end
    end
end
local function consumeJJS(_,inputState)
    if not ActivityControls.isBlocked() or not ActivityControls.getActivity() then
        return Enum.ContextActionResult.Pass
    end
    if UIS:GetFocusedTextBox() then return Enum.ContextActionResult.Pass end
    return Enum.ContextActionResult.Sink
end
local function setJjsBlocked(value)
    ActivityControls.setBlocked(value==true)
    if ActivityControls.isBlocked() then
        ActivityControls.stop("AUTO OFF | bloqueio ativo; atividade do Roblox mantida.",false)
        pcall(function()
            ContextActionService:BindActionAtPriority(blockActionName,consumeJJS,false,10000,
                Enum.KeyCode.Q,Enum.KeyCode.E,Enum.KeyCode.Y,Enum.KeyCode.ButtonY)
        end)
    else
        pcall(function()ContextActionService:UnbindAction(blockActionName)end)
        touchBlockGui.Enabled=false
        releaseBlockTouch()
    end
end
