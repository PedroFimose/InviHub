local combatPriority = function() return false end
-- Auxiliares de mira: com cursor livre, mira real = cursor fisico.
-- Um LocalScript normal NAO possui API para reposicionar o mouse do sistema.
-- mousemoverel/mousemoveabs sao disponibilizadas somente em alguns ambientes.
local function aimExecutorMethod(name)
 local fn
 pcall(function() fn=env[name] end)
 if type(fn)~="function" then pcall(function() fn=_G[name] end) end
 if type(fn)~="function" then
  if name=="mousemoverel" then
   pcall(function() if type(mousemoverel)=="function" then fn=mousemoverel end end)
  elseif name=="mousemoveabs" then
   pcall(function() if type(mousemoveabs)=="function" then fn=mousemoveabs end end)
  end
 end
 return type(fn)=="function" and fn or nil
end
local cursorMoveRelative=aimExecutorMethod("mousemoverel")
local cursorMoveAbsolute=aimExecutorMethod("mousemoveabs")
local function aimOrigin(cam)
 local free=not isMobile and UIS.MouseEnabled and UIS.MouseBehavior==Enum.MouseBehavior.Default
 return free and UIS:GetMouseLocation() or cam.ViewportSize/2,free
end
-- Coordenadas da mira, circulos e cursor devem usar o mesmo viewport.
-- GetMouseLocation e ScreenGui.IgnoreGuiInset nao descontam a barra superior.
local function aimProject(cam,part,free)
 return cam:WorldToViewportPoint(part.Position)
end
local function aimStrength(power,dt,instant)
 if instant then return 1 end
 local p=math.clamp(power/100,0,1)
 if p<=0 then return 0 end
 if p>=.999 then return 1 end
 return math.clamp(1-math.exp(-(1.5+80*p*p)*math.clamp(dt,1/240,.1)),0,1)
end
local function aimApplyTarget(cam,part,origin,free,power,dt,instant)
 if not part or not part.Parent then return false,"sem alvo" end
 local projected,visible=aimProject(cam,part,free)
 if not visible or projected.Z<=0 then return false,"fora da tela" end
 local gain=aimStrength(power,dt,instant)
 if gain<=0 then return false,"forca zero" end
 if free then
  local delta=Vector2.new(projected.X,projected.Y)-origin
  local dx=math.clamp(math.round(delta.X*gain),-800,800)
  local dy=math.clamp(math.round(delta.Y*gain),-800,800)
  if math.abs(delta.X)>1 and dx==0 then dx=delta.X>0 and 1 or -1 end
  if math.abs(delta.Y)>1 and dy==0 then dy=delta.Y>0 and 1 or -1 end
  if math.abs(delta.X)<=1 then dx=0 end
  if math.abs(delta.Y)<=1 then dy=0 end
  if dx==0 and dy==0 then return true,"alinhado" end
  -- Reavaliar APIs disponibilizadas tardiamente pelo executor, sem erro fatal.
  if not cursorMoveRelative then cursorMoveRelative=aimExecutorMethod("mousemoverel") end
  if not cursorMoveAbsolute then cursorMoveAbsolute=aimExecutorMethod("mousemoveabs") end
  if cursorMoveRelative then
   local ok=pcall(cursorMoveRelative,dx,dy)
   if ok then return true,"cursor" end
  end
  if cursorMoveAbsolute then
   local ok=pcall(cursorMoveAbsolute,math.round(origin.X+dx),math.round(origin.Y+dy))
   if ok then return true,"cursor" end
  end
  -- Roblox nao oferece reposicionamento do cursor pelo LocalScript padrao.
  -- Quando o executor nao permite mover o mouse, alinhar o RAIO que sai
  -- da posicao atual do cursor, alterando so a camera. Nunca falhar mudo.
 end
 -- Com Shift Lock ajusta a camera; sem API de cursor usa a mesma tecnica
 -- compensando a posicao do mouse solto, para alinhar o disparo com a tela.
 local viewport=cam.ViewportSize
 if viewport.Y<=0 then return false,"viewport indisponivel" end
 local delta=origin-viewport/2
 local depth=math.max(1,(part.Position-cam.CFrame.Position):Dot(cam.CFrame.LookVector))
 local worldPerPixel=2*depth*math.tan(math.rad(cam.FieldOfView)/2)/viewport.Y
 local offset=cam.CFrame.RightVector*(delta.X*worldPerPixel)-cam.CFrame.UpVector*(delta.Y*worldPerPixel)
 local desired=CFrame.lookAt(cam.CFrame.Position,part.Position-offset)
 cam.CFrame=cam.CFrame:Lerp(desired,gain)
 return true,free and "camera (fallback; cursor indisponivel)" or "camera (cursor travado)"
end
