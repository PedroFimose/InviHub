-- ===================== ALGEMAS / RESISTENCIA =====================
-- Tratamento do botao e dos estados replicados do minigame.
-- O servidor continua decidindo se a resistencia realmente liberta o personagem.
local prisonRemote
local lastResistAttempt=-math.huge
local resistanceLoop=false
local RESIST_MIN_INTERVAL=0.8
local pendingManualToken=0
local pendingLoopToken=0
local responseToken=0
local algemaCard=card(page,1468,190)
label(algemaCard,"ALGEMAS | RESISTENCIA",UDim2.fromOffset(14,8),UDim2.new(1,-28,0,23),13,true)
label(algemaCard,"Solicita resistencia; a liberacao depende da validacao do servidor.",UDim2.fromOffset(14,31),UDim2.new(1,-28,0,33),10,false,COLOR.faded)
local resistButton=button(algemaCard,"SAIR DA ALGEMA (TENTAR)",UDim2.fromOffset(14,71),UDim2.new(1,-28,0,35),COLOR.input)
local resistLoopCheck=button(algemaCard,"☐  LOOP SAIR DA ALGEMA",UDim2.fromOffset(14,113),UDim2.new(1,-28,0,30),COLOR.input)
local resistStatus=label(algemaCard,"Aguardando solicitacao.",UDim2.fromOffset(14,149),UDim2.new(1,-28,0,32),10,false,COLOR.faded)
local function isCuffed()
 local who=player:GetAttribute("AlgemadoPor")
 return who~=nil and who~=false and who~=""
end
local function getPrisonRemote()
 if prisonRemote and prisonRemote.Parent and prisonRemote:IsA("RemoteEvent") then return prisonRemote end
 prisonRemote=nil
 local replicated=game:GetService("ReplicatedStorage")
 local remotes=replicated:FindFirstChild("Remotes")
 local events=remotes and remotes:FindFirstChild("Events")
 local prison=events and events:FindFirstChild("Prison")
 local algemar=prison and prison:FindFirstChild("Algemar")
 if algemar and algemar:IsA("RemoteEvent") then
  prisonRemote=algemar
  return algemar
 end
 return nil
end
local function tryResist(isManual)
 if not devAlive then return false end
 if not isCuffed() then
  resistStatus.Text="Voce nao esta algemado."
  return false
 end
 if player:GetAttribute("PodeResistir")~=true then
  resistStatus.Text="Resistencia ainda nao liberada pelo jogo."
  return false
 end
 local current=os.clock()
 local remaining=RESIST_MIN_INTERVAL-(current-lastResistAttempt)
 if remaining>0 then
  if isManual then
   resistStatus.Text=("Aguarde %.1f s antes de solicitar novamente."):format(remaining)
  end
  return false
 end
 local event=getPrisonRemote()
 if not event then
  resistStatus.Text="Evento Algemar nao carregado; tente novamente."
  return false
 end
 local ok,err=pcall(function()event:FireServer("Resistência")end)
 if not ok then
  resistStatus.Text="Falha ao solicitar: "..tostring(err):sub(1,70)
  return false
 end
 lastResistAttempt=current
 responseToken+=1
 local token=responseToken
 resistStatus.Text="Solicitacao enviada. Aguardando resultado do servidor..."
 task.delay(1.2,function()
  if not devAlive or token~=responseToken then return end
  if not isCuffed() then
   resistStatus.Text="Algema removida (estado confirmado)."
  else
   resistStatus.Text="Ainda algemado: servidor pode ter negado ou aplicado espera."
  end
 end)
 return true
end
local function queueManualWhenReady()
 pendingManualToken+=1
 local token=pendingManualToken
 if not isCuffed() then
  resistStatus.Text="Nao foi detectada uma algema ativa."
  return
 end
 if player:GetAttribute("PodeResistir")==true then
  tryResist(true)
  return
 end
 resistStatus.Text="Aguardando o jogo liberar a resistencia..."
 task.spawn(function()
  for i=1,6 do
   task.wait(0.25)
   if not devAlive or token~=pendingManualToken then return end
   if not isCuffed() then
    resistStatus.Text="Algema removida."
    return
   end
   if player:GetAttribute("PodeResistir")==true then
    tryResist(true)
    return
   end
  end
  if devAlive and token==pendingManualToken then
   resistStatus.Text="Resistencia indisponivel. Pode existir bloqueio do servidor."
  end
 end)
end
local function queueLoopAttempt()
 pendingLoopToken+=1
 local token=pendingLoopToken
 if not devAlive or not resistanceLoop or not isCuffed() then return end
 task.delay(0.25,function()
  if not devAlive or not resistanceLoop or token~=pendingLoopToken then return end
  if isCuffed() and player:GetAttribute("PodeResistir")==true then
   tryResist(false)
  end
 end)
end
on(resistButton.Activated,queueManualWhenReady)
on(resistLoopCheck.Activated,function()
 resistanceLoop=not resistanceLoop
 resistLoopCheck.Text=resistanceLoop and "☑  LOOP SAIR DA ALGEMA" or "☐  LOOP SAIR DA ALGEMA"
 resistLoopCheck.BackgroundColor3=resistanceLoop and COLOR.green or COLOR.input
 resistStatus.Text=resistanceLoop and "Loop ativo: aguarda nova oportunidade de resistencia." or "Loop de resistencia desativado."
 if resistanceLoop then queueLoopAttempt() else pendingLoopToken+=1 end
end)
on(player:GetAttributeChangedSignal("PodeResistir"),function()
 if resistanceLoop and player:GetAttribute("PodeResistir")==true then
  queueLoopAttempt()
 end
end)
on(player:GetAttributeChangedSignal("AlgemadoPor"),function()
 if not isCuffed() then
  pendingManualToken+=1
  pendingLoopToken+=1
  responseToken+=1
  resistStatus.Text="Algema removida (estado confirmado)."
 elseif resistanceLoop then
  queueLoopAttempt()
 end
end)

