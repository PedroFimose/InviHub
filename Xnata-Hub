    local function parkourBindReserved(key,slot)
        if key==Enum.KeyCode.Unknown or key==Enum.KeyCode.Escape or key==Enum.KeyCode.G
            or key==toggleKey or key==Enum.KeyCode.Q or key==Enum.KeyCode.E
            or key==Enum.KeyCode.W or key==Enum.KeyCode.A or key==Enum.KeyCode.S or key==Enum.KeyCode.D
            or key==Enum.KeyCode.Space or key==Enum.KeyCode.LeftControl then return true end
        if type(settings.aimBind)=="string" and settings.aimBind==key.Name then return true end
        for other,name in pairs(parkourBinds) do
            if other~=slot and name==key.Name then return true end
        end
        return false
    end
    on(UIS.InputBegan,function(input,processed)
        if input.UserInputType~=Enum.UserInputType.Keyboard then return end
        if bindCaptureInProgress=="parkour" and captureBindSlot then
            local slot=captureBindSlot
            if input.KeyCode==Enum.KeyCode.Escape then
                bindCaptureInProgress=nil;captureBindSlot=nil
                if chooseBindButtons[slot] then chooseBindButtons[slot].Text="ESCOLHER BIND" end
                updateBindLabel(slot)
                return
            end
            if parkourBindReserved(input.KeyCode,slot) then
                bindCaptureInProgress=nil;captureBindSlot=nil
                if chooseBindButtons[slot] then chooseBindButtons[slot].Text="ESCOLHER BIND" end
                if bindLabels[slot] then bindLabels[slot].Text="Tecla reservada ou já utilizada." end
                return
            end
            parkourBinds[slot]=input.KeyCode.Name
            justCapturedBindKey=input.KeyCode.Name
            justCapturedBindUntil=os.clock()+.2
            saveParkourBinds()
            bindCaptureInProgress=nil;captureBindSlot=nil
            if chooseBindButtons[slot] then chooseBindButtons[slot].Text="ESCOLHER BIND" end
            updateBindLabel(slot)
            return
        end
        if bindCaptureInProgress~=nil or captureKey or processed or UIS:GetFocusedTextBox() then return end
        if justCapturedBindKey==input.KeyCode.Name and os.clock()<=justCapturedBindUntil then return end
        for slot,name in pairs(parkourBinds) do
            if name==input.KeyCode.Name then
                if active and active.kind=="mapping" then
                    setStatus(slot,"Finalize ou exclua a gravação antes de usar a bind.")
                    return
                end
                if active and active.kind=="playing" and active.slot==slot then
                    stopActive("Reprodução parada pela bind.")
                else
                    beginPlayback(slot)
                end
                return
            end
        end
    end)

