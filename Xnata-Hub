local function copyToClipboard(value)
    local textValue=tostring(value or "")
    local fn=type(setclipboard)=="function" and setclipboard
        or (type(toclipboard)=="function" and toclipboard)
        or (type(env.setclipboard)=="function" and env.setclipboard)
        or (type(env.toclipboard)=="function" and env.toclipboard)
    if fn then
        local ok,err=pcall(fn,textValue)
        if ok then return true,"copiado" end
        return false,tostring(err)
    end
    local writer=type(writefile)=="function" and writefile
        or (type(env.writefile)=="function" and env.writefile)
    if writer then
        local ok,err=pcall(writer,"Xnata_Clipboard_Fallback.txt",textValue)
        if ok then return true,"salvo em Xnata_Clipboard_Fallback.txt" end
        return false,tostring(err)
    end
    return false,"Clipboard/arquivos indisponíveis neste executor."
end

