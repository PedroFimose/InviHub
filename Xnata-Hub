    -- Frame: t, x,y,z, 9 componentes da orientacao, velocidade xyz,
    -- estado humanoid, evento de salto (0 ou 1).
    local function capture(a,forced)
        if active~=a then return end
        if not a.root.Parent or not a.hum.Parent or a.hum.Health<=0 then
            stopActive("Gravação interrompida: personagem indisponível.");return
        end
        local t=os.clock()-a.started
        if t>maxDuration or #a.frames>=maxFrames then
            stopActive("Limite de gravação alcançado (150 s).");return
        end
        local before=a.frames[#a.frames]
        if before and not forced and t-before[1]<sampleInterval*.78 then return end
        local cf=a.root.CFrame
        local x,y,z,r00,r01,r02,r10,r11,r12,r20,r21,r22=cf:GetComponents()
        local v=a.root.AssemblyLinearVelocity
        local state=a.hum:GetState()
        local jump=(a.jumpEvent or state==Enum.HumanoidStateType.Jumping) and 1 or 0
        if jump==1 and not a.wasJumping then
            a.jumpCount+=1
        end
        a.wasJumping=jump==1
        a.jumpEvent=false
        local f={round(t),round(x),round(y),round(z),
            round(r00),round(r01),round(r02),round(r10),round(r11),round(r12),
            round(r20),round(r21),round(r22),round(v.X),round(v.Y),round(v.Z),
            state.Value,jump}
        a.frames[#a.frames+1]=f
    end
    local function beginPlayback(i,personalRoute)
        if active then stopActive("Atividade anterior encerrada.") end
        local route=personalRoute or (i>0 and selectedOrDraft(i)) or routeForSlot(i)
        if not valid(route) then
            setStatus(i,"Rota oficial indisponivel neste jogo. Confira o PlaceId.")
            return
        end
        local hum,root=character()
        if not hum then setStatus(i,"Personagem indisponível.");return end
        local start=coord(route.frames[1])
        local difference=(root.Position-start).Magnitude
        if difference>3.2 then
            setStatus(i,string.format("Volte à largada: distância %.1f studs (máx. 3,2).",difference))
            return
        end
        local a={kind="playing",slot=i,hum=hum,root=root,route=route,
            cursor=1,playTime=0,elapsedReal=0,paused=false,
            oldAutoRotate=hum.AutoRotate,originalWalkSpeed=hum.WalkSpeed,
            rate=i==0 and 1 or replayRate(i),
            lastExpected=pose(route.frames[1]),wasJumpSignal=false,
            deviations=0,updates=0}
        active=a
        hum.AutoRotate=false
        if i>=1 and i<=4 and selectedMode[i]>=2 then
            hum.WalkSpeed=a.originalWalkSpeed+1
        end
        setStatus(i,string.format("REPRODUZINDO trajetória (%.2fx).", a.rate))
        refreshAll()
    end
    local function pausePlayback(i)
        local a=active
        if not a or a.kind~="playing" or a.slot~=i then
            setStatus(i,"Nenhuma reprodução ativa.");return
        end
        a.paused=not a.paused
        setStatus(i,a.paused and "PAUSADO. Clique em RETOMAR." or "Reprodução retomada.")
        refresh(i)
    end
    -- Avanca os quadros pelo tempo de gravacao, com interpolacao de CFrame.
    local function stepPlayback(a,dt)
        local hum,root=a.hum,a.root
        if not hum.Parent or not root.Parent or hum.Health<=0 or player.Character~=root.Parent then
            stopActive("Reprodução encerrada: personagem indisponível.");return
        end
        if a.paused then
            root.CFrame=a.lastExpected
            root.AssemblyLinearVelocity=Vector3.zero
            root.AssemblyAngularVelocity=Vector3.zero
            return
        end
        dt=math.clamp(dt,0,.09)
        a.elapsedReal+=dt
        if a.elapsedReal>math.max(25,a.route.duration/math.max(a.rate,.1)*2+10) then
            stopActive("Reprodução interrompida: tempo de segurança excedido.");return
        end
        a.playTime=math.min(a.route.duration,a.playTime+dt*a.rate)
        local frames=a.route.frames
        while a.cursor<#frames-1 and frames[a.cursor+1][1]<a.playTime do
            a.cursor+=1
        end
        local f1=frames[a.cursor]
        local f2=frames[math.min(#frames,a.cursor+1)]
        local duration=f2[1]-f1[1]
        local factor=duration>.00001 and math.clamp((a.playTime-f1[1])/duration,0,1) or 0
        local cf=pose(f1):Lerp(pose(f2),factor)
        local vx=f1[14]+(f2[14]-f1[14])*factor
        local vy=f1[15]+(f2[15]-f1[15])*factor
        local vz=f1[16]+(f2[16]-f1[16])*factor
        -- O personagem NAO procura waypoints: reconstitui a transformacao gravada.
        -- Sem anchor: ancorar normalmente impede replicacao fisica do cliente.
        local correction=(root.Position-a.lastExpected.Position).Magnitude
        if correction>3.8 then
            a.deviations+=1
        else
            a.deviations=math.max(0,a.deviations-1)
        end
        if a.deviations>=12 then
            stopActive("O servidor/física está corrigindo a posição. Replay cliente incompatível neste jogo.")
            return
        end
        -- Aplicar orientacao/posicao e velocidade fornece uma tentativa de
        -- animacao e replicacao. Nenhuma delas pode ser garantida sem servidor.
        root.CFrame=cf
        root.AssemblyLinearVelocity=Vector3.new(vx,vy,vz)
        root.AssemblyAngularVelocity=Vector3.zero
        local signal=f1[18]==1 or f2[18]==1
        if signal and not a.wasJumpSignal then
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
        end
        a.wasJumpSignal=signal
        a.lastExpected=cf
        a.updates+=1
        if a.playTime>=a.route.duration then
            stopActive("TRAJETÓRIA CONCLUÍDA. Confirme se o servidor mostrou o mesmo movimento.")
        elseif a.updates%135==0 then
            setStatus(a.slot,string.format("Reproduzindo: %.1f/%.1f s. Desvios: %d.",
                a.playTime,a.route.duration,a.deviations))
        end
    end
    on(RunService.Heartbeat,function(dt)
        if not alive then return end
