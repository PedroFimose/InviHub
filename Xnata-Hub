local function updateKeyAim(cam,dt,origin,free)
 local region=heldKeyAimRegion()
 if not region then return end
 local closest=keyAimRadius
 local chosen
 for _,other in ipairs(Players:GetPlayers()) do
  if other~=player and other.Character then
   local hum=other.Character:FindFirstChildOfClass("Humanoid")
   local part=other.Character:FindFirstChild(region) or (region=="UpperTorso" and other.Character:FindFirstChild("Torso"))
   if hum and hum.Health>0 and part then
    local sp,vis=aimProject(cam,part,free)
    if vis and sp.Z>0 then
     local d=(Vector2.new(sp.X,sp.Y)-origin).Magnitude
     if d<closest then closest=d;chosen=part end
    end
   end
  end
 end
 if chosen then aimApplyTarget(cam,chosen,origin,free,100,dt,true) end
end
