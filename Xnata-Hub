    -- Exporta frames de verdade, sem depender de um ID curto nem de storage local.
    -- Cada codigo identifica jogo, percurso e modo e carrega a gravacao integral.
    local function draftKey(i)
        return i<=4 and routeKey(i,selectedMode[i]) or ("tower:"..tostring(i-4))
    end
    local function getDraft(i)
        return drafts[draftKey(i)]
    end
    local function selectedOrDraft(i)
        local draft=getDraft(i)
        if draft then return draft end
        if i<=4 then
            local route=confirmed[routeKey(i,selectedMode[i])]
            -- Até existir um mapeamento TAF V2 próprio, usa a rota TAF como base.
            if not valid(route) and selectedMode[i]==4 then route=confirmed[routeKey(i,3)] end
            return route
        end
        return towerConfirmed[i-4]
    end
