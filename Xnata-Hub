    local function clearTrail()
        if trail then trail:Destroy();trail=nil end
    end
    local function drawTrail(route, color, folderName)
        clearTrail()
        if not valid(route) then return false end
        local frames=route.frames
        trail=Instance.new("Folder")
        trail.Name=folderName or "InvHub_Linha_Local"
        trail.Parent=workspace
        local increment=math.max(1,math.ceil(#frames/220))
        for k=1,#frames-1,increment do
            local a=coord(frames[k])-Vector3.new(0,1.6,0)
            local b=coord(frames[math.min(#frames,k+increment)])-Vector3.new(0,1.6,0)
            local d=b-a
            if d.Magnitude>.06 then
                local p=Instance.new("Part")
                p.Name="Linha"
                p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false
                p.Material=Enum.Material.Neon;p.Color=color;p.Transparency=.38
                p.Size=Vector3.new(.11,.11,d.Magnitude)
                p.CFrame=CFrame.lookAt((a+b)/2,b)
                p.Parent=trail
            end
        end
        local last=-1
        for k=1,#frames do
            local f=frames[k]
            if f[18]==1 and f[1]-last>.22 then
                last=f[1]
                local p=Instance.new("Part")
                p.Name="Salto"
                p.Shape=Enum.PartType.Ball;p.Size=Vector3.new(.6,.6,.6)
                p.Position=coord(f)-Vector3.new(0,1.45,0)
                p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false
                p.Material=Enum.Material.Neon;p.Color=color
                p.Parent=trail
            end
        end
        return true
    end
    local function routeForSlot(i)
        -- Torres prontas: carregar somente mapeamentos ja confirmados.
        if i>=5 and i<=6 then return towerConfirmed[i-4] end
        local route=confirmed[routeKey(i,selectedMode[i])]
        if not valid(route) and selectedMode[i]==4 then route=confirmed[routeKey(i,3)] end
