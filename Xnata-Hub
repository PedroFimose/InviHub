local function bodyPart(ch)
 if not ch then return nil end
 if aimRegion=="Cabeça" then return ch:FindFirstChild("Head") end
 return ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso") or ch:FindFirstChild("LowerTorso")
end
local function targetInfo(pl,cam,origin,allowed,free)
 local ch=pl and pl.Character
 if not ch then return nil end
 local hum=ch:FindFirstChildOfClass("Humanoid")
 if not hum or hum.Health<=0 then return nil end
 local part=bodyPart(ch)
 if not part or not part:IsA("BasePart") then return nil end
 local projected,visible=aimProject(cam,part,free)
 if not visible or projected.Z<=0 then return nil end
 local dist=(Vector2.new(projected.X,projected.Y)-origin).Magnitude
 if dist>allowed then return nil end
 return part,dist
end
local function acquire(cam,origin,free)
 if lockedPlayer and lockedPlayer.Parent==Players then
  local part=targetInfo(lockedPlayer,cam,origin,aimRadius,free)
  if part then return lockedPlayer,part end
 end
 lockedPlayer=nil
 local bestDistance=aimRadius
 local bestPlayer,bestPart=nil,nil
 for _,other in ipairs(Players:GetPlayers()) do
  if other~=player then
   local part,dist=targetInfo(other,cam,origin,aimRadius,free)
   if part and dist<bestDistance then
    bestDistance=dist;bestPlayer=other;bestPart=part
   end
  end
 end
 lockedPlayer=bestPlayer
 return bestPlayer,bestPart
end
