local function syncBones(pl,character,cam)
 local segments=boneLines[pl]
 if not skeleton or not permitted(pl) or not character then clearBones(pl);return end
 if not segments then segments={};boneLines[pl]=segments end
 local idx=0
 for _,names in ipairs(skeletonEdges) do
  local a=character:FindFirstChild(names[1])
  local b=character:FindFirstChild(names[2])
  if a and b and a:IsA("BasePart") and b:IsA("BasePart") then
   local pa=cam:WorldToViewportPoint(a.Position)
   local pb=cam:WorldToViewportPoint(b.Position)
   if pa.Z>0 and pb.Z>0 then
    idx+=1
    local line=segments[idx]
    if not line then
     line=make("Frame",{BackgroundColor3=COLOR.white,BorderSizePixel=0,AnchorPoint=Vector2.new(0,.5),ZIndex=10},espOverlay)
     segments[idx]=line
    end
    local delta=Vector2.new(pb.X-pa.X,pb.Y-pa.Y)
    line.Visible=true
    line.Position=UDim2.fromOffset(pa.X,pa.Y)
    line.Size=UDim2.fromOffset(math.max(2,delta.Magnitude),2)
    line.Rotation=math.deg(math.atan2(delta.Y,delta.X))
   end
  end
 end
 for i=idx+1,#segments do segments[i].Visible=false end
end
