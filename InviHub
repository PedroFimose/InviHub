for i=1,#encoded do
 local symbol=encoded:sub(i,i)
 if symbol=="=" then break end
 local v=lookup[symbol]
 if v~=nil then
  acc=acc*64+v;bits=bits+6
  if bits>=8 then
   bits=bits-8
   local value=math.floor(acc/2^bits)
   result[#result+1]=string.char(value%256)
   acc=acc%2^bits
  end
 end
end
